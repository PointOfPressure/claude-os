# /etc/environment: managed by claude-os (config/environment/environment).
# Read by pam_env for EVERY session, including `ssh host command` non-login
# shells. This is the layer that makes the token-economy vars unavoidable.

# No colour, no pagers, no prompts.
NO_COLOR=1
CLICOLOR=0
PAGER=cat
GIT_PAGER=cat
MANPAGER=cat
SYSTEMD_PAGER=
DEBIAN_FRONTEND=noninteractive

# npm / pnpm (both read NPM_CONFIG_* from the environment)
NPM_CONFIG_FUND=false
NPM_CONFIG_AUDIT=false
NPM_CONFIG_PROGRESS=false
NPM_CONFIG_LOGLEVEL=warn
NPM_CONFIG_UPDATE_NOTIFIER=false

# pip / uv
PIP_PROGRESS_BAR=off
PIP_DISABLE_PIP_VERSION_CHECK=1
PIP_NO_INPUT=1
UV_NO_PROGRESS=1

# .NET
DOTNET_CLI_TELEMETRY_OPTOUT=1
DOTNET_NOLOGO=1

# Playwright browsers live in a shared system path (stage 60)
PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
